# Local Python environments.
.venv/
venv/
env/
htk/

# Only keep source/config/notebooks at the top level of data/. All downloaded
# archives, raw splits, generated labels, COCO exports and other artifacts stay
# local even if their directory names change in a later download.
data/*
!data/.gitkeep
!data/*.py
!data/*.yaml
!data/*.yml
!data/*.ipynb

# Training artifacts are reproducible and too large for Git.
models/checkpoints/
models/runs/
*.pth
*.pt
